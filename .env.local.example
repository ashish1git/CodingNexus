# ==============================
# Coding Nexus — Local Development Environment
# ==============================
#
# HOW TO USE:
#   cp .env.example .env.local
#   edit .env.local with your values
#   docker compose -f docker-compose.dev.yml up -d --build
#
# This file IS gitignored (matches *.local in .gitignore)
# ==============================

# ── Server ──
NODE_ENV=development
PORT=3000

# ── Database (connects to the db container via Docker DNS) ──
DATABASE_URL=postgresql://sumit:sumit123@db:5432/sumitdb

# ── JWT ──
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# ── CORS (allow your local Vite dev server) ──
FRONTEND_URL=http://localhost:5173

# ── Judge0 (connects to judge0-server container via Docker DNS) ──
JUDGE0_URL=http://judge0-server:2358
VITE_JUDGE0_URL=http://localhost:2358

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=dtxktmolj
CLOUDINARY_API_KEY=<CHANGE_ME>
CLOUDINARY_API_SECRET=<CHANGE_ME>
VITE_CLOUDINARY_CLOUD_NAME=dtxktmolj
VITE_CLOUDINARY_UPLOAD_PRESET=profile_photos
VITE_CLOUDINARY_NOTES_PRESET=codingnexus_notes

# ── Brevo Email (use test keys or same production keys) ──
BREVO_API_KEY=<CHANGE_ME>
BREVO_API_KEY_SECONDARY=<CHANGE_ME>
EMAIL_FROM=<CHANGE_ME>
EMAIL_FROM_SECONDARY=<CHANGE_ME>
EMAIL_FROM_NAME=Coding Nexus
EMAIL_SERVICE=brevo

# ── Async Submissions ──
ENABLE_POLLING=false
POLL_INTERVAL=15000

# ── Maintenance ──
MAINTENANCE_MODE=false
VITE_MAINTENANCE_MODE=false

# ── AI APIs ──
USE_GEMINI_DIRECT=false
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Frontend ──
VITE_API_URL=/api
