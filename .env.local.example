# ==============================
# Coding Nexus — Local Development Environment
# ==============================
#
# HOW TO USE:
#   cp .env.local.example .env.local
#   Edit .env.local with your real values
#   npm run dev:all
#
# Services (PostgreSQL + Judge0) run via Docker:
#   docker compose -f docker-compose.dev.yml up -d
#
# App runs NATIVELY with hot-reload:
#   npm run dev:all     (starts Vite on :5173 + Express on :3000)
#
# This file IS gitignored — never commit real secrets.
# ==============================

# ── Server ──
NODE_ENV=development
PORT=3000

# ── Database (localhost — running in Docker, port 5432 mapped) ──
DATABASE_URL=postgresql://sumit:sumit123@localhost:5432/sumitdb

# ── JWT ──
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# ── CORS (allow Vite dev server + Express) ──
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# ── Judge0 (localhost — running in Docker, port 2358 mapped) ──
JUDGE0_URL=http://localhost:2358
VITE_JUDGE0_URL=http://localhost:2358

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=dtxktmolj
CLOUDINARY_API_KEY=<CHANGE_ME>
CLOUDINARY_API_SECRET=<CHANGE_ME>
VITE_CLOUDINARY_CLOUD_NAME=dtxktmolj
VITE_CLOUDINARY_UPLOAD_PRESET=profile_photos
VITE_CLOUDINARY_NOTES_PRESET=codingnexus_notes

# ── Brevo Email ──
BREVO_API_KEY=<CHANGE_ME>
BREVO_API_KEY_SECONDARY=<CHANGE_ME>
EMAIL_FROM=<CHANGE_ME>
EMAIL_FROM_SECONDARY=<CHANGE_ME>
EMAIL_FROM_NAME=Coding Nexus
EMAIL_SERVICE=brevo

# ── Async Submissions ──
ENABLE_POLLING=false
POLL_INTERVAL=15000

# ── Maintenance ──
MAINTENANCE_MODE=false
VITE_MAINTENANCE_MODE=false

# ── AI APIs ──
USE_GEMINI_DIRECT=false
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Frontend ──
VITE_API_URL=/api
