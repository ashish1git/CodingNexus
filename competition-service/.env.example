# ==============================
# Competition Service — Environment Template
# ==============================
#
# HOW TO USE:
#   cp .env.example .env
#   Fill in all values and start with: npm start
#
# These values must match the main CodingNexus application.
# NEVER commit .env with real secrets!
# ==============================

# ── Server ──────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Database (same as main app — shared PostgreSQL) ──
DATABASE_URL=postgresql://user:password@localhost:5432/codingnexus

# ── JWT (must match main app exactly) ───────────
JWT_SECRET=<CHANGE_ME — must match server JWT_SECRET>

# ── Judge0 (code execution engine) ──────────────
JUDGE0_URL=http://localhost:2358
