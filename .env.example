# ==============================
# Coding Nexus — Environment Template
# ==============================
# 
# HOW TO USE:
#   1. cp .env.example .env              (for docker-compose build args)
#   2. cp .env.example .env.docker       (for container runtime)
#   3. Fill in all values marked with <CHANGE_ME>
#   4. docker compose up -d --build
#
# NEVER commit .env or .env.docker with real secrets!
# .env.example is the only env file tracked in git.
# ==============================

# ── Server ──────────────────────────
NODE_ENV=production
PORT=3000

# ── Database ───────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/codingnexus

# ── JWT ────────────────────────────
JWT_SECRET=<CHANGE_ME_generate_with_openssl_rand_-hex_64>
JWT_EXPIRES_IN=7d

# ── CORS ───────────────────────────
FRONTEND_URL=https://codingnexus.apsit.edu.in

# ── Judge0 (code execution engine, runs as Docker container) ──
JUDGE0_URL=http://localhost:2358
VITE_JUDGE0_URL=http://localhost:2358

# ── Cloudinary (image/notes upload) ──
CLOUDINARY_CLOUD_NAME=dtxktmolj
CLOUDINARY_API_KEY=<CHANGE_ME_your_cloudinary_api_key>
CLOUDINARY_API_SECRET=<CHANGE_ME_your_cloudinary_api_secret>
VITE_CLOUDINARY_CLOUD_NAME=dtxktmolj
VITE_CLOUDINARY_UPLOAD_PRESET=profile_photos                 # unsigned preset for profile photos
VITE_CLOUDINARY_NOTES_PRESET=codingnexus_notes               # unsigned preset for notes/files

# ── Brevo Email (primary + fallback for quota protection) ──
# Both senders MUST be verified in Brevo dashboard before use.
BREVO_API_KEY=<CHANGE_ME_your_brevo_primary_key>
BREVO_API_KEY_SECONDARY=<CHANGE_ME_your_brevo_fallback_key>
EMAIL_FROM=<CHANGE_ME_verified_sender_email>
EMAIL_FROM_SECONDARY=<CHANGE_ME_verified_fallback_email>
EMAIL_FROM_NAME=Coding Nexus
EMAIL_SERVICE=brevo

# ── Async Submissions ──────────────
ENABLE_POLLING=false
POLL_INTERVAL=15000

# ── Maintenance Mode ───────────────
MAINTENANCE_MODE=false
VITE_MAINTENANCE_MODE=false

# ── AI APIs (optional) ─────────────
# Set USE_GEMINI_DIRECT=true to use Google Gemini directly.
# Leave both empty to disable AI features.
USE_GEMINI_DIRECT=false
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Nexi AI Support Assistant ──────
# Comma-separated admin emails that receive escalations from the Nexi chatbot.
AI_ESCALATION_EMAILS=codingnexus@apsit.edu.in,23106031@apsit.edu.in

# Nexi AI provider: set AI_PROVIDER=local to use a local OpenAI-compatible
# endpoint (e.g. Ollama / llama.cpp /v1) as the primary; Gemini is the fallback.
# Leave unset (or set to "gemini") for the existing Gemini integration.
AI_PROVIDER=local
LOCAL_AI_BASE=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=/opt/local-ai/models/Qwen3-8B-Q4_K_M.gguf
# Output token budgets: normal answers ~800, longer code reviews/explanations ~1200.
LOCAL_MAX_TOKENS_DEFAULT=800
LOCAL_MAX_TOKENS_LONG=1200
# Per-student AI safeguards (in-memory, per process).
NEXI_MAX_PER_MINUTE=5
NEXI_MAX_PER_DAY=100
NEXI_MAX_ACTIVE=1
NEXI_MAX_CONCURRENT=2
NEXI_QUEUE_SIZE=5
NEXI_QUEUE_TIMEOUT_MS=30000

# ── Frontend (build-time) ──────────
VITE_API_URL=/api
